# ============================================================
# ⚙️  ملف الإعدادات — انسخه لـ .env واملأ القيم
# ============================================================

# قاعدة البيانات (SQLite) — المسار المحلي لملف قاعدة البيانات
DATABASE_URL="file:./dev.db"

# Discord OAuth2 App
# إزاي تجيبهم:
# 1. روح https://discord.com/developers/applications
# 2. New Application → OAuth2 → Redirects: http://localhost:3000/api/auth/discord/callback
# 3. انسخ Client ID و Client Secret
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback

# Secret key للسيشن (اكتب أي string عشوائي قوي)
SESSION_SECRET=ChangeThisToASuperSecretRandomString123!@#

# Cloudflare Turnstile
# إزاي تجيبهم:
# 1. روح https://dash.cloudflare.com → Turnstile
# 2. Add widget → Managed
# 3. انسخ Site Key و Secret Key
TURNSTILE_SITE_KEY=0x00000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000

# آيديهات الأدمن الأساسيين (مفصولين بفاصلة)
# احط هنا آيدي ديسكورد بتاعك عشان تقدر تدخل الأدمن من أول مرة
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# إعدادات السيرفر
PORT=3000
NODE_ENV=development

# رابط ويب هوك ديسكورد (اختياري — للإشعارات)
DISCORD_WEBHOOK_URL=